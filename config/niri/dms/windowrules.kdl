// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="^org\\.gnome\\."
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^nm-connection-editor$"
    default-column-width { proportion 0.5; }
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^xdg-desktop-portal$"
    open-floating true
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="^steam$" title="^notificationtoasts_\\d+_desktop$"
    open-focused false
}

// @id=dms_rule_5 @name=
window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

// @id=dms_rule_6 @name=
window-rule {
    match app-id="zoom" title="^Picture-in-Picture$"
    open-floating true
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="org.quickshell$"
    open-floating true
}

// @id=dms_rule_8 @name=
window-rule {
    match app-id="brave-browser"
    open-maximized true
    open-on-workspace "1"
}

// @id=dms_rule_9 @name=
window-rule {
    match app-id="Tor Browse"
    open-maximized true
    open-on-workspace "1"
}

// @id=dms_rule_10 @name=
window-rule {
    match app-id="Firefox Beta"
    open-maximized-to-edges true
    open-on-workspace "1"
}

// @id=dms_rule_11 @name=
window-rule {
    match app-id="kitty" title="rmpc"
    open-floating true
    open-on-workspace "3"
}

// @id=dms_rule_12 @name=
window-rule {
    match app-id="nwg-look"
    open-floating true
}

// @id=dms_rule_13 @name=
window-rule {
    match app-id="^floating-term$"
    open-floating true
}

// @id=dms_rule_14 @name=Reaper
window-rule {
    match app-id="^REAPER"
    open-maximized true
}

// Matches folder creation and error alerts in Thunar
window-rule {
    match app-id=r#"^thunar$"# title=r#"^Rename.*$"#
    match app-id=r#"^thunar$"# title=r#"^Create.*$"#
    match app-id=r#"^thunar$"# title=r#"^Confirm.*$"#
    match app-id=r#"^thunar$"# title=r#"^Attention$"#
    match app-id=r#"^thunar$"# title=r#"^Confirm to replace files$"#
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 400; }

}
window-rule {
    match app-id=r#"org\.gtk\.FileChooserDialog"#
    open-floating true
}

window-rule {
    match app-id="org.qbittorrent.qBittorrent" title="^Open.*"
    match app-id="org.qbittorrent.qBittorrent" title="^Select.*"
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// System dialogs
window-rule {
    match title=r#".*(Dialog|Properties|Preferences|Settings|Rename).*"#
    open-floating true
}

window-rule {
    match app-id=r#"Bitwarden"# title=r#".*unlock.*"#
    open-floating true
}

window-rule {
    match app-id=r#"blueman-manager"#
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

window-rule {
    match app-id=r#"Bitwarden"#
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
}

window-rule {
    match title="^Extension: \\(Bitwarden"
    open-floating true
}

window-rule {
   match app-id=r#"^mpv$"#
   open-floating true
}

window-rule {
   match app-id=r#"^org.gnome.FileRoller$"#
   open-floating true
   default-column-width { fixed 600; }
   default-window-height { fixed 600; }
}
