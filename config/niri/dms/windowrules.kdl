// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten
// General blur fallback
window-rule {
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="Alacritty"

    background-effect {
        blur true
    }
}

// @id=dms_rule_0 @name=
window-rule {
    match app-id="^org\\.wezfurlong\\.wezterm$"
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="^org\\.gnome\\."
    geometry-corner-radius 12
    clip-to-geometry true
    draw-border-with-background false
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="^nm-connection-editor$"
    default-column-width { proportion 0.5; }
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^xdg-desktop-portal$"
    open-floating true
}

// @id=dms_rule_4 @name=
window-rule {
    match app-id="^steam$" title="^notificationtoasts_\\d+_desktop$"
    open-focused false
}

// @id=dms_rule_5 @name=
window-rule {
    match app-id="kitty"
    draw-border-with-background false
}

// @id=dms_rule_6 @name=
window-rule {
    match app-id="zoom" title="^Picture-in-Picture$"
    open-floating true
}

// @id=dms_rule_7 @name=
window-rule {
    match app-id="org.quickshell$"
    open-floating true
}

// @id=dms_rule_8 @name=
window-rule {
    match app-id="brave-browser"
    open-maximized true
    open-on-workspace "1"
}

// @id=dms_rule_9 @name=
window-rule {
    match app-id="Tor Browse"
    open-maximized true
    open-on-workspace "1"
}

// @id=dms_rule_10 @name=
window-rule {
    match app-id="Firefox Beta"
    open-maximized-to-edges true
    open-on-workspace "1"
}

// @id=dms_rule_11 @name=
window-rule {
    match title="rmpc"
    open-maximized true
    open-on-workspace "3"
    default-column-width { fixed 1900; }
    default-window-height { fixed 600; }
    opacity 0.70
    background-effect {
    blur true
    xray false
    }

}

// @id=dms_rule_12 @name=
window-rule {
    match app-id="nwg-look"
    open-floating true
}

// @id=dms_rule_13 @name=
window-rule {
    match app-id="^floating-term$"
    open-floating true
    opacity 0.70
    background-effect {
        blur true
        xray false
    }
}

// @id=dms_rule_14 @name=Reaper
window-rule {
    match app-id="^REAPER"
    open-maximized true
}

// Matches folder creation and error alerts in Thunar
window-rule {
    match app-id=r#"^thunar$"# title=r#"^Rename.*$"#
    match app-id=r#"^thunar$"# title=r#"^Create.*$"#
    match app-id=r#"^thunar$"# title=r#"^Confirm.*$"#
    match app-id=r#"^thunar$"# title=r#"^Attention$"#
    match app-id=r#"^thunar$"# title=r#"^Confirm to replace files$"#
    match app-id=r#"^thunar$"# title="File Operation Progress"
    open-floating true
    default-column-width { fixed 400; }
    default-window-height { fixed 400; }
    opacity 0.80
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="^thunar$"
    opacity 0.75
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="^pcmanfm$"
    opacity 0.80
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="sublime_text"
    opacity 0.85
    background-effect {
        blur true
        xray false
    }
}

// @id=dms_rule_16 @name=
window-rule {
    match app-id="org\\.gtk\\.FileChooserDialog"
    open-floating true
}

// @id=dms_rule_17 @name=
window-rule {
    match app-id="org.qbittorrent.qBittorrent" title="^Select.*"
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// @id=dms_rule_18 @name=
window-rule {
    match title=".*(Dialog|Properties|Preferences|Settings|Rename).*"
    open-floating true
    background-effect {
    blur true
    }
}

// @id=dms_rule_19 @name=
window-rule {
    match app-id="Bitwarden" title=".*unlock.*"
    open-floating true
}

// @id=dms_rule_20 @name=
window-rule {
    match app-id="blueman-manager"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 600; }
}

// @id=dms_rule_21 @name=
window-rule {
    match app-id="Bitwarden"
    open-floating true
    default-column-width { fixed 800; }
    default-window-height { fixed 800; }
}

// @id=dms_rule_22 @name=
window-rule {
    match title="^Extension: \\(Bitwarden"
    open-floating true
}

// @id=dms_rule_23 @name=
window-rule {
    match app-id="^mpv$"
    open-floating true
}

// @id=dms_rule_24 @name=
window-rule {
    match app-id="File-roller"
    open-floating true
    default-column-width { fixed 600; }
    default-window-height { fixed 600; }
}

// @id=wr_1781949541614785813 @name=Firefox Beta
window-rule {
    match app-id="^Firefox Beta$" title="^Extension: (Bitwarden Password Manager) - Bitwarden — Mozilla Firefox$"
    open-floating true
}

window-rule {
    match app-id="arandr"
    open-floating true
}
window-rule {
    match app-id="com.saivert.pwvucontrol"
    open-floating true
}

window-rule {
    match app-id="Gtick"
    open-floating true
}

// Enable blur behind the fuzzel launcher.
layer-rule {
    match namespace="^launcher$"
    opacity 0.75

    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="^pcmanfm$"
    opacity 0.80
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="^org.bleachbit.BleachBit"
    opacity 0.80
    background-effect {
