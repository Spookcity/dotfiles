        xray false
    }
}

window-rule {
    match app-id="^git-cola"
    opacity 0.85
    background-effect {
        blur true
        xray false
    }
}

window-rule {
    match app-id="^org.qbittorrent.qBittorrent"
    opacity 0.85
    background-effect {
